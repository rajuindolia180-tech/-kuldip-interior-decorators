}

.gallery-card img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:transform .4s;
}

.gallery-card:hover img{
    transform:scale(1.04);
}

.gallery-card.hide{
    display:none;
}

.card-caption{
    position:absolute;
    left:0;
    right:0;
    bottom:0;
    padding:35px 16px 14px;
    color:white;
    background:linear-gradient(
